filters:
  and:
    - 'file.inFolder("_A_My Research/_Book Markups & Highlights/Kindle Book Notes")'
    - 'file.ext == "md"'
views:
  - type: table
    name: Table
    order:
      - file.name
      - note.Author
      - note.Tags
      - note.Thumbnail
  - type: cards
    name: Cards
    image: note.Thumbnail
