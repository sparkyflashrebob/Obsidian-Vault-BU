filters:
  and:
    - 'file.inFolder("_A_My Research/_Book Markups & Highlights")'
    - 'file.ext == "md"'
views:
  - type: table
    name: Table
    order:
      - file.name
      - note.Domain
      - note.Category
      - note.Created
      - note.Updated
  - type: cards
    name: Cards
    image: note.Thumbnail
