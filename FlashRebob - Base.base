views:
  - type: table
    name: Table
    order:
      - file.name
      - file.folder
      - file.tags
      - author
      - created
      - "Dates:"
      - updated
      - title
      - tag
      - tags
    sort:
      - property: file.name
        direction: ASC
      - property: file.folder
        direction: ASC
    columnSize:
      file.name: 491
      file.folder: 414
      file.tags: 73
      note.Author: 120
      "note.Dates:": 75
      note.updated: 57
      note.title: 81
      note.tag: 52
  - type: list
    name: View
